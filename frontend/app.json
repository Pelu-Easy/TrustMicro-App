{
  "expo": {
    "name": "TrustMicro Bank",
    "slug": "trustmicro-bank",
    "version": "1.0.0",
    "owner": "peluisrael",
    "orientation": "portrait",
    "backgroundColor": "#ffffff",
    "icon": "./assets/images/icon.png",
    "scheme": "trustmicro-bank",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "54.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "com.peluisrael.trustmicro",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "kotlinVersion": "1.9.24",
            "newArchEnabled": false,
            "javaVersion": 17
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cc3eb8c4-3d3b-49db-a30e-64481b4934c9"
      }
    }
  }
}